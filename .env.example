# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 git에 올라가지 않는다)
# 아래는 `docker compose up -d`로 띄운 로컬 Postgres·Redis에 맞춘 값이다.

# 로컬에서 React 개발 서버(3000)와 겹치지 않게 3001을 쓴다.
PORT=3001

# 앱이 쓰는 DB 주소. Supabase에서는 트랜잭션 풀러(6543, ?pgbouncer=true)를 쓴다.
DATABASE_URL=postgresql://swyp:swyp@localhost:5433/swyp
# 마이그레이션이 쓰는 주소. Supabase에서는 풀러를 거치지 않는 연결을 쓴다.
# (홈서버는 IPv6가 안 돼서 IPv4가 되는 세션 풀러 5432를 쓴다.)
DIRECT_URL=postgresql://swyp:swyp@localhost:5433/swyp

REDIS_URL=redis://localhost:6380

# 브라우저에서 API를 부를 수 있는 주소(쉼표로 구분). 없으면 localhost:3000, 5173만 허용한다.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
